# PostgreSQL connection string. Use Supabase's transaction pooler for Vercel/serverless.
DATABASE_URL="postgresql://postgres.aiukonlywtwgkwdtryiu:YOUR_URL_ENCODED_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Public URL used by the application. This value is exposed to the browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Only needed once for: pnpm auth:create-admin
SOLEANDO_ADMIN_EMAIL="admin@example.com"
SOLEANDO_ADMIN_NAME="Administrador"
SOLEANDO_ADMIN_PASSWORD="replace-with-a-strong-password"
